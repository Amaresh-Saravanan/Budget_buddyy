# Copy to keystore.properties (git-ignored) and fill in with the values you
# chose when generating the keystore. See MOBILE.md → "Building a signed APK".
#
# storeFile is resolved relative to the android/ directory.
storeFile=budgetbuddy-release.jks
storePassword=your_keystore_password
keyAlias=budgetbuddy
keyPassword=your_key_password
