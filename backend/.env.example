# BudgetBuddy Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Neon Database Connection
# Get your connection string from https://console.neon.tech/
# Format: postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/budgetbuddy?sslmode=require
# Get this when setting up webhooks in Clerk Dashboard
CLERK_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5175

# ==================== Bank Email Auto-Sync ====================
# Gmail App Password (https://myaccount.google.com/apppasswords), requires
# 2-Step Verification to be enabled on the Gmail account first.
GMAIL_IMAP_USER=your_email@gmail.com
GMAIL_IMAP_APP_PASSWORD=your_16_char_app_password

BANK_ALERT_SENDER=alerts@axis.bank.in
EMAIL_SYNC_INTERVAL_MINUTES=15
SYNC_USER_ID=
